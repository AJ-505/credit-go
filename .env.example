# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Drizzle (SQLite)
# Local: file:./data.db
# Turso: libsql://your-db.turso.io
DATABASE_URL="file:./data.db"
DATABASE_AUTH_TOKEN=""

# Public app URL used for OAuth redirects and provider webhooks.
APP_BASE_URL="http://localhost:3000"

# LumiID: NIN and CAC verification
LUMIID_API_KEY=""
LUMIID_BASE_URL="https://api.lumiid.com"

# Mono: Telco Data and Mono Connect
MONO_SECRET_KEY=""
MONO_PUBLIC_KEY=""
NEXT_PUBLIC_MONO_PUBLIC_KEY=""
MONO_BASE_URL="https://api.withmono.com"
# Current public Mono Telco docs use v2. Set to v3 if Mono provisions the v3 contract for your account.
MONO_TELCO_API_VERSION="v2"

# Squad: BVN-backed virtual accounts, account lookup, payments
SQUAD_SECRET_KEY=""
SQUAD_BASE_URL="https://sandbox-api-d.squadco.com"
SQUAD_MERCHANT_GT_BANK_ACCOUNT=""

# Cr3dentials: gig income verification
CR3DENTIALS_API_KEY=""
CR3DENTIALS_BASE_URL="https://api.cr3dentials.xyz"
CR3DENTIALS_WEBHOOK_SECRET=""

# LinkedIn OpenID Connect
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/linkedin/callback"

# Python/FastAPI ML scoring service
ML_SERVICE_URL="http://127.0.0.1:8000"
NGN_USD_RATE="1500"

# Work email OTP delivery. If RESEND_API_KEY is blank in development,
# the OTP is returned by the mutation response for local testing.
RESEND_API_KEY=""
EMAIL_FROM="CreditGo <onboarding@example.com>"

# Payslip OCR. The regex parser is local; Document AI needs the two Google values.
PAYSLIP_OCR_PROVIDER="regex"
GOOGLE_DOCUMENT_AI_ENDPOINT=""
GOOGLE_DOCUMENT_AI_ACCESS_TOKEN=""
